# ==============================================================================
# OpenClaw Multi-Agent Telegram System - Environment Variables Template
# ==============================================================================
# Security Notice:
# 1. Copy this file to .env on your server: cp .env.example .env
# 2. Populate your actual keys and tokens below.
# 3. Restrict permissions immediately:
#      chmod 600 .env
#      chown 1000:1000 .env
# ==============================================================================

# LLM Provider API Keys
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>

# Telegram Bot API Tokens (obtained from @BotFather)
TELEGRAM_BOT_TOKEN_JARVIS=<BOT_TOKEN_JARVIS>
TELEGRAM_BOT_TOKEN_CYRA=<BOT_TOKEN_CYRA>
TELEGRAM_BOT_TOKEN_SAM=<BOT_TOKEN_SAM>
TELEGRAM_BOT_TOKEN_DEV=<BOT_TOKEN_DEV>

# Gateway Runtime Settings
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=0.0.0.0
OPENCLAW_DISABLE_BONJOUR=true
